-- _head/model.yaml --
version: 1
layers:
  - name: entry
    description: Commands.
    may_use: [entry, core]
  - name: core
    description: Values.
    may_use: [core]
components:
  - name: app
    layer: entry
    responsibility: Runs the application.
    packages: [cmd/app, internal/app]
    uses: [values]
  - name: values
    layer: core
    responsibility: Holds values.
    packages: [internal/values]
  - name: extra
    layer: core
    responsibility: Doubles values.
    packages: [internal/extra]
    uses: [values]
public: []
vendored: []
rules:
  unassigned-package: Fix unassigned-package.
  stale-package: Fix stale-package.
  forbidden-import: Fix forbidden-import.
  forbidden-module: Fix forbidden-module.
  unresolved-import: Fix unresolved-import.
  undeclared-public-package: Fix undeclared-public-package.
  invalid-model: Fix invalid-model.
  missing-design: Fix missing-design.
  invalid-design: Fix invalid-design.
  design-package-missing: Fix design-package-missing.
  design-imports-differ: Fix design-imports-differ.
  design-forbidden: Fix design-forbidden.
  design-model-changes-differ: Fix design-model-changes-differ.
  stale-diagram: Fix stale-diagram.
-- _head/extra.go --
// Package extra doubles values.
package extra

import "example.com/fixture/internal/values"

// Double returns twice the value.
func Double() int { return 2 * values.X }
-- _head/forbidden.go --
// Package extra doubles values.
package extra

import "example.com/fixture/internal/app"

// Double runs the application.
func Double() { app.Run() }
-- _head/design.md --
---
design: 1
issue: 7
packages:
  - path: internal/extra
    component: extra
    imports: [example.com/fixture/internal/values]
model_changes: [component:extra]
---

# Issue #7: Extra Design
-- _head/go-architecture.md --
# Architecture

<!-- Generated from architecture/model.yaml by archcheck diagram. Do not edit. -->
```mermaid
flowchart TB
    subgraph layer_entry[entry]
        component_app[app]
    end
    subgraph layer_core[core]
        component_values[values]
        component_extra[extra]
    end
    component_app --> component_values
    component_extra --> component_values
```
<!-- End of the generated diagram. -->

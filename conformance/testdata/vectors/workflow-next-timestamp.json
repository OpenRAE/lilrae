{
  "corpus": 1,
  "scheme": "workflow-next-timestamp",
  "version": "current",
  "owner": "aptl.core.runtime.workflow_engine._next_timestamp",
  "cases": [
    {
      "id": "z-whole-second",
      "input": {
        "previous": "2026-03-24T02:00:00Z",
        "offset_ms": 1
      },
      "expect": {
        "text": "2026-03-24T02:00:00.001000Z"
      }
    },
    {
      "id": "offset-input",
      "input": {
        "previous": "2026-03-24T02:00:00+00:00",
        "offset_ms": 1
      },
      "expect": {
        "text": "2026-03-24T02:00:00.001000Z"
      }
    },
    {
      "id": "fraction",
      "input": {
        "previous": "2026-03-24T02:00:00.999Z",
        "offset_ms": 1
      },
      "expect": {
        "text": "2026-03-24T02:00:01Z"
      }
    },
    {
      "id": "rollover",
      "input": {
        "previous": "2026-12-31T23:59:59.999999Z",
        "offset_ms": 1
      },
      "expect": {
        "text": "2027-01-01T00:00:00.000999Z"
      }
    },
    {
      "id": "naive",
      "input": {
        "previous": "2026-03-24T02:00:00",
        "offset_ms": 1
      },
      "note": "a naive input stays naive",
      "expect": {
        "text": "2026-03-24T02:00:00.001000"
      }
    },
    {
      "id": "not-a-timestamp",
      "input": {
        "previous": "yesterday",
        "offset_ms": 1
      },
      "expect": {
        "reject": "parse"
      }
    }
  ]
}

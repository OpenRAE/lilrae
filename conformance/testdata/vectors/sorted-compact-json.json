{
  "corpus": 1,
  "scheme": "sorted-compact-json",
  "version": "current",
  "owner": "json.dumps(sort_keys=True, separators=(',', ':')) encoded as UTF-8",
  "cases": [
    {
      "id": "ascii-sorted",
      "input": {
        "b": 1,
        "a": [
          1,
          2
        ],
        "c": {
          "z": null,
          "y": true
        }
      },
      "expect": {
        "hex": "7b2261223a5b312c325d2c2262223a312c2263223a7b2279223a747275652c227a223a6e756c6c7d7d"
      }
    },
    {
      "id": "non-ascii-escaped",
      "input": {
        "ké": "vé€"
      },
      "note": "ensure_ascii escapes non-ASCII characters",
      "expect": {
        "hex": "7b226b5c7530306539223a22765c75303065395c7532306163227d"
      }
    },
    {
      "id": "supplementary-plane",
      "input": {
        "e": "😀"
      },
      "note": "a supplementary character is a surrogate pair escape",
      "expect": {
        "hex": "7b2265223a225c75643833645c7564653030227d"
      }
    },
    {
      "id": "html-characters-raw",
      "input": {
        "h": "<a href='x'>&</a>"
      },
      "note": "Python does not escape <, >, and &",
      "expect": {
        "hex": "7b2268223a223c6120687265663d2778273e263c2f613e227d"
      }
    },
    {
      "id": "float-one",
      "input": {
        "n": {
          "$float": "1.0"
        }
      },
      "note": "json.dumps writes 1.0",
      "expect": {
        "hex": "7b226e223a312e307d"
      }
    },
    {
      "id": "negative-zero",
      "input": {
        "n": {
          "$float": "-0.0"
        }
      },
      "expect": {
        "hex": "7b226e223a2d302e307d"
      }
    },
    {
      "id": "float-exponent",
      "input": {
        "big": {
          "$float": "1e21"
        },
        "small": {
          "$float": "1e-7"
        },
        "repr": {
          "$float": "0.1"
        }
      },
      "expect": {
        "hex": "7b22626967223a31652b32312c2272657072223a302e312c22736d616c6c223a31652d30377d"
      }
    },
    {
      "id": "integer-large",
      "input": {
        "n": {
          "$int": "123456789012345678901234567890"
        }
      },
      "expect": {
        "hex": "7b226e223a3132333435363738393031323334353637383930313233343536373839307d"
      }
    },
    {
      "id": "nan-written",
      "input": {
        "n": {
          "$float": "nan"
        }
      },
      "note": "allow_nan writes NaN, which is not JSON",
      "expect": {
        "hex": "7b226e223a4e614e7d"
      }
    },
    {
      "id": "infinity-written",
      "input": {
        "n": {
          "$float": "inf"
        },
        "m": {
          "$float": "-inf"
        }
      },
      "expect": {
        "hex": "7b226d223a2d496e66696e6974792c226e223a496e66696e6974797d"
      }
    },
    {
      "id": "key-order-code-point",
      "input": {
        "דּ": 1,
        "😀": 2,
        "a": 3
      },
      "note": "sort_keys orders by code point, not UTF-16",
      "expect": {
        "hex": "7b2261223a332c225c7566623333223a312c225c75643833645c7564653030223a327d"
      }
    },
    {
      "id": "empty-and-nested",
      "input": {
        "a": {},
        "b": [],
        "c": ""
      },
      "expect": {
        "hex": "7b2261223a7b7d2c2262223a5b5d2c2263223a22227d"
      }
    },
    {
      "id": "float-forms",
      "input": {
        "f00": {
          "$float": "1e-05"
        },
        "f01": {
          "$float": "0.0001"
        },
        "f02": {
          "$float": "0.00012345"
        },
        "f03": {
          "$float": "9999999999999998.0"
        },
        "f04": {
          "$float": "1e+16"
        },
        "f05": {
          "$float": "1.5e+16"
        },
        "f06": {
          "$float": "1.2345678901234568e+17"
        },
        "f07": {
          "$float": "0.1"
        },
        "f08": {
          "$float": "0.30000000000000004"
        },
        "f09": {
          "$float": "0.3333333333333333"
        },
        "f10": {
          "$float": "-1.5e-10"
        },
        "f11": {
          "$float": "1e+22"
        },
        "f12": {
          "$float": "1e+23"
        },
        "f13": {
          "$float": "1.7976931348623157e+308"
        },
        "f14": {
          "$float": "5e-324"
        },
        "f15": {
          "$float": "2.2250738585072014e-308"
        },
        "f16": {
          "$float": "100.0"
        },
        "f17": {
          "$float": "1234.5"
        },
        "f18": {
          "$float": "-0.5"
        },
        "f19": {
          "$float": "1e-07"
        },
        "f20": {
          "$float": "1.2345678901234568e+16"
        }
      },
      "expect": {
        "hex": ""
      },
      "note": "Python writes the exponent form when the decimal point position is at most -4 or above 16."
    },
    {
      "id": "integer-above-digit-limit",
      "input": {
        "n": {
          "$int": ""
        }
      },
      "expect": {
        "reject": "serialize"
      },
      "note": "Python writes no integer with more than 4300 digits."
    }
  ]
}

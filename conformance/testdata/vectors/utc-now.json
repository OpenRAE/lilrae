{
  "corpus": 1,
  "scheme": "utc-now",
  "version": "current",
  "owner": "aptl.core.correlation.clock.utc_now",
  "cases": [
    {
      "id": "whole-second",
      "input": "2026-03-24T02:00:00+00:00",
      "note": "isoformat omits a zero fraction",
      "expect": {
        "text": "2026-03-24T02:00:00Z"
      }
    },
    {
      "id": "microseconds",
      "input": "2026-03-24T02:00:00.123456+00:00",
      "expect": {
        "text": "2026-03-24T02:00:00.123456Z"
      }
    },
    {
      "id": "trailing-zero-microseconds",
      "input": "2026-03-24T02:00:00.120000+00:00",
      "note": "isoformat keeps six digits",
      "expect": {
        "text": "2026-03-24T02:00:00.120000Z"
      }
    },
    {
      "id": "milliseconds-only",
      "input": "2026-03-24T02:00:00.001000+00:00",
      "expect": {
        "text": "2026-03-24T02:00:00.001000Z"
      }
    },
    {
      "id": "other-offset-instant",
      "input": "2026-03-24T04:00:00+02:00",
      "note": "the producer converts to UTC",
      "expect": {
        "text": "2026-03-24T02:00:00Z"
      }
    }
  ]
}

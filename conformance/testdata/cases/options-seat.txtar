stdout '--image-cache([^-\w]|$)'
stdout '--yes([^-\w]|$)'
stdout '(^|[^-\w])-y\b'
stdout '--desktop-mode([^-\w]|$)'

lilrae seat recover --help
stdout '--seat-root([^-\w]|$)'
stdout '--seat-id([^-\w]|$)'
stdout '--image([^-\w]|$)'

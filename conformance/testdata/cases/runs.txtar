# The runs commands read the run store of the project. A run ID can be a
# unique prefix. A legacy flat manifest stays readable.
lilrae lab init proj
cd proj
lilrae runs list
stdout 'run-ready\tMaterialization envelope\t2026-03-24T02:00:00'
stdout 'run-legacy\tMaterialization envelope\t2026-03-20T10:00:00'
stdout '2 run\(s\) shown \(of 2 total\)'
lilrae runs list --limit 1
stdout '1 run\(s\) shown \(of 2 total\)'

lilrae runs show run-ready
stdout 'Run: run-ready'
stdout 'Scenario ID: +materialization-envelope'
stdout 'Started: +2026-03-24T02:00:00Z'
lilrae runs show run-leg
stdout 'Run: run-legacy'
stdout 'Flags: +2'
stdout 'Containers: +smoke-box'

# An ambiguous or unknown run ID is an error.
! lilrae runs show run
status 1
! lilrae runs show nope
status 1

lilrae runs path run-ready
stdout 'runs/run-ready'

lilrae runs export run-legacy --output-dir out
exists out/run-legacy.tar.gz

# A project without runs has an empty run store.
cd $WORK
lilrae lab init empty
cd empty
lilrae runs list
stdout 'No experiment runs found\.'


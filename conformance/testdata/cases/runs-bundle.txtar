# lilrae runs export-bundle writes an evidence bundle whose bundle.json
# conforms to the published schema. Without a verified seal, the bundle is
# unsealed and says so. lilrae runs verify-bundle verifies it.
lilrae lab init proj
cd proj
lilrae runs export-bundle run-ready --output-dir bundles
stdout 'seal: UNSEALED'
stdout 'seal-absent'
exists bundles/run-ready.evidence-bundle.tar
mkdir extracted
exec tar -xf bundles/run-ready.evidence-bundle.tar -C extracted
schema evidence-bundle.schema.json extracted/bundle.json
lilrae runs verify-bundle bundles/run-ready.evidence-bundle.tar
stdout 'OK: bundle verified'

# A file that is not a bundle fails verification.
! lilrae runs verify-bundle $WORK/not-a-bundle.tar
status 1

-- not-a-bundle.tar --
not a bundle

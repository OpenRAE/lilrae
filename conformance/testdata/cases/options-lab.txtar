stdout '--project-dir([^-\w]|$)'
stdout '(^|[^-\w])-d\b'
stdout '--interval([^-\w]|$)'
stdout '--max-ticks([^-\w]|$)'
stdout '--grace-minutes([^-\w]|$)'


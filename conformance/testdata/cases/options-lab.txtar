# Each command accepts its options. The case checks the option names in the
# help, not the help layout or the format of the defaults. Typer's
# completion options and hidden options and commands are implementation
# details. A wide terminal keeps a help table from shortening long option
# names.
env COLUMNS=240

lilrae lab --help

lilrae lab continuity-audit --help
stdout '--project-dir'
stdout '(^|[^-\w])-d\b'
stdout '--target'
stdout '(^|[^-\w])-t\b'
stdout '--whitelist'
stdout '--json'
stdout '--run-id'

lilrae lab init --help
stdout '--force'
stdout '(^|[^-\w])-f\b'

lilrae lab enforce --help
stdout '--project-dir'
stdout '(^|[^-\w])-d\b'
stdout '--grace-minutes'

lilrae lab monitor --help
stdout '--project-dir'
stdout '(^|[^-\w])-d\b'
stdout '--interval'
stdout '--max-ticks'
stdout '--grace-minutes'

